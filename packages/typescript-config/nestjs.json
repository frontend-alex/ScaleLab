{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./internal-package.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "incremental": true,
    "lib": ["ES2023"],
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "ES2023"
  }
}
