# Required in every environment.
# Use "development" locally and "production" on Railway.
NODE_ENV=

# Local Docker/Compose ports. Railway provides PORT automatically, so these
# are normally not needed for Railway services.
API_PORT=
HOST=0.0.0.0
WORKER_PORT=

# URL allowed by the API CORS policy.
# Development: http://localhost:3000
# Production: your deployed web URL, for example:
# https://scalelab-web.up.railway.app
WEB_ORIGIN=

# Browser-facing API URL used by the web app.
# Development: http://localhost:3001
# Production: your deployed API URL, for example:
# https://scalelab-api.up.railway.app
API_URL=

# Required by the worker.
# Development with Compose: REDIS_HOST=redis, REDIS_PORT=6379
# Production: use your managed Redis host and port.
REDIS_HOST=
REDIS_PORT=

# Development-only PostgreSQL container settings.
# These are used by compose.dev.yaml and can be omitted in production when
# using managed PostgreSQL.
POSTGRES_USER=scalelab
POSTGRES_PASSWORD=scalelab
POSTGRES_DB=scalelab

# Database connection used by the API.
# Development with Compose: use the postgres service hostname.
# Production: use the private/managed PostgreSQL connection string.
DATABASE_URL=postgresql://scalelab:scalelab@postgres:5432/scalelab

# Required in every environment. Use a unique secret with at least 32 chars
# in production. Never commit the real value.
JWT_SECRET=
